{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "angular-pokedex",
  "projectType": "application",
  "generators": {
    "@schematics/angular:application": {
      "strict": true
    }
  },
  "sourceRoot": "src",
  "prefix": "app",
  "i18n": {
    "sourceLocale": {
      "code": "en-US",
      "subPath": ""
    },
    "locales": {
      "pt-BR": {
        "translation": "src/locale/messages.pt-BR.xlf",
        "subPath": "pt"
      },
      "es": {
        "translation": "src/locale/messages.es.xlf",
        "subPath": "es"
      }
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "outputPath": {
          "base": "dist/angular-pokedex"
        },
        "index": "src/index.html",
        "tsConfig": "tsconfig.app.json",
        "assets": [
          {
            "glob": "*.svg",
            "input": "./node_modules/bootstrap-icons/icons/",
            "output": "/assets/icons/"
          },
          "src/favicon.ico",
          "src/assets"
        ],
        "styles": [
          "./node_modules/bootstrap/dist/css/bootstrap.min.css",
          "src/styles.scss"
        ],
        "scripts": [],
        "browser": "src/main.ts",
        "polyfills": [
          "@angular/localize/init"
        ],
        "i18nMissingTranslation": "error"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all",
          "localize": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "pt": {
          "localize": [
            "pt-BR"
          ]
        },
        "es": {
          "localize": [
            "es"
          ]
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{options.outputPath.base}"
      ]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "angular-pokedex:build:production"
        },
        "development": {
          "buildTarget": "angular-pokedex:build:development"
        },
        "pt": {
          "buildTarget": "angular-pokedex:build:development,pt"
        },
        "es": {
          "buildTarget": "angular-pokedex:build:development,es"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "angular-pokedex:build",
        "outputPath": "src/locale"
      }
    },
    "lint": {
      "command": "eslint src e2e playwright.config.ts",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs"
      ]
    }
  },
  "tags": [
    "scope:pokedex",
    "type:app"
  ]
}
